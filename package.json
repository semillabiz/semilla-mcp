{
  "name": "semilla-mcp",
  "version": "1.2.1",
  "description": "MCP Server para Semilla ERP — accedé a tus datos del ERP desde Claude Desktop, Claude Code y otros clientes MCP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "semilla-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "verify:tools": "tsx evaluations/verify-tools.ts",
    "prepublishOnly": "npm run build && npm run verify:tools"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "semilla",
    "semilla-erp",
    "erp",
    "anthropic",
    "claude",
    "argentina",
    "afip",
    "arca"
  ],
  "license": "MIT",
  "author": "Semilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semillabiz/semilla-mcp.git"
  },
  "homepage": "https://github.com/semillabiz/semilla-mcp#readme",
  "bugs": {
    "url": "https://github.com/semillabiz/semilla-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
